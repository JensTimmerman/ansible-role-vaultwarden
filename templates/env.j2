## Vaultwarden Configuration File

{% if vaultwarden_install_type == "apt" %}
WEB_VAULT_FOLDER=/usr/share/vaultwarden-web-vault/
{% endif %}
{% for key, value in vaultwarden_config.items() %}
{% if value is boolean %}
{{ key }}={{ 'true' if value else 'false' }}
{% elif value is number %}
{{ key }}={{ value }}
{% else %}
{{ key }}="{{ value }}"
{% endif %}
{% endfor %}
